{
  "manifest_version": 3,
  "name": "Cookie Sync · Kalodata/Kalowave",
  "version": "2.4",
  "description": "Sincroniza cookies de Kalodata/Kalowave. v2.4: so envia com o navegador logado (confere em /api/sso/clip-token) e respeita a recusa do servidor, pra sessao anonima nunca substituir a sessao boa. Mantem: servidor padrao kalo-api.domma.ai, ping ativo, ciclo de 5min e listener de cookie change.",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.kalodata.com/*",
    "https://kalodata.com/*",
    "https://*.kalowave.com/*",
    "https://*.kaloclip.com/*",
    "http://187.127.0.217:3456/*",
    "http://187.127.0.217:5174/*",
    "http://*/api/cookies",
    "https://*/api/cookies"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "Cookie Sync · Domma"
  }
}
